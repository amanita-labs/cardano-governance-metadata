{
  "name": "@amanita-labs/cardano-governance-metadata",
  "version": "0.1.3",
  "description": "TypeScript library for fetching, parsing, validating, and verifying Cardano governance metadata (CIP-100, CIP-108, CIP-119, CIP-136, CIP-169)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cip100": {
      "types": "./dist/cip100/index.d.ts",
      "default": "./dist/cip100/index.js"
    },
    "./cip108": {
      "types": "./dist/cip108/index.d.ts",
      "default": "./dist/cip108/index.js"
    },
    "./cip119": {
      "types": "./dist/cip119/index.d.ts",
      "default": "./dist/cip119/index.js"
    },
    "./cip136": {
      "types": "./dist/cip136/index.d.ts",
      "default": "./dist/cip136/index.js"
    },
    "./cip169": {
      "types": "./dist/cip169/index.d.ts",
      "default": "./dist/cip169/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun run build:esm && bun run build:types && bun run check:dist",
    "check:dist": "node scripts/check-dist-exports.mjs",
    "build:esm": "node scripts/build-esm.mjs",
    "build:types": "tsc --project tsconfig.build.json --emitDeclarationOnly",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit",
    "lint": "biome check ./src",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build && bun test"
  },
  "dependencies": {
    "@noble/ed25519": "^2.2.3",
    "blakejs": "^1.2.1",
    "cbor2": "^2.3.0",
    "jsonld": "^8.3.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@emurgo/cardano-serialization-lib-nodejs": "^14.1.2",
    "@types/jsonld": "^1.5.15",
    "bun-types": "^1.2.5",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@emurgo/cardano-serialization-lib-asmjs": "*",
    "@emurgo/cardano-serialization-lib-browser": "*",
    "@emurgo/cardano-serialization-lib-nodejs": "*"
  },
  "peerDependenciesMeta": {
    "@emurgo/cardano-serialization-lib-asmjs": {
      "optional": true
    },
    "@emurgo/cardano-serialization-lib-browser": {
      "optional": true
    },
    "@emurgo/cardano-serialization-lib-nodejs": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amanita-labs/governance-metadata.git"
  }
}
